{
  "name": "offline-language-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "test:net": "cargo test --manifest-path src-tauri/Cargo.toml --lib network_ -- --ignored --nocapture",
    "deny": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "check": "npm run fmt:check && npm run lint && npm run test:rust && npm test",
    "models": "./scripts/download-models.sh"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
