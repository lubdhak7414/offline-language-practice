{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "offline-language-practice",
  "version": "0.1.0",
  "identifier": "com.offline.practice",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Offline Language Practice",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Education",
    "copyright": "Copyright © 2026 Offline Language Practice",
    "createUpdaterArtifacts": false,
    "license": "MIT",
    "publisher": "Offline Language Practice",
    "resources": {
      "../models/": "models/"
    },
    "shortDescription": "Offline-first language practice: on-device ASR, TTS, FSRS, grammar, SQLite"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:app.db"]
    }
  }
}
